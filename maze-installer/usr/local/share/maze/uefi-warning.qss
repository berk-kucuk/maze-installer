/* Maze Linux — dark styling for the "UEFI required" installer warning.
 *
 * kdialog (Qt) is launched with `-style Fusion -stylesheet <this file>` so the
 * dialog does NOT inherit whatever palette the session hands it (which rendered
 * as a washed-out light gray). Fusion + this sheet give a consistent very-dark-
 * gray panel with light text on every machine, and widen the message via the
 * QLabel min-width. Qt strips `-stylesheet` in QApplication before kdialog's own
 * argument parser runs, so passing it here is safe.
 */

QWidget,
QDialog,
QMessageBox {
    background-color: #202124;   /* very dark gray (not the OLED true-black) */
    color: #e8eaed;
}

/* Text colour only. Width is driven by a fixed-width <table> inside the message
 * HTML, NOT a QLabel min-width — a min-width here would also stretch the message
 * box's icon label and leave a big gap between the icon and the text. */
QLabel {
    color: #e8eaed;
    font-size: 11pt;
}

QPushButton {
    background-color: #3a3a3d;
    color: #ffffff;
    border: 1px solid #555a5f;
    border-radius: 5px;
    padding: 7px 20px;
    min-width: 96px;
}

QPushButton:hover {
    background-color: #45464a;
}

QPushButton:focus {
    border: 1px solid #8ab4f8;   /* clear keyboard-focus ring */
}

QPushButton:pressed {
    background-color: #2e2f32;
}
