/* Maze Linux — Calamares stylesheet (OLED theme).
 *
 * The sidebar and the Back/Next bar are QML (calamares-sidebar.qml,
 * calamares-navigation.qml); this file styles the pages between them.
 *
 * Palette — QSS has no variables, so these are repeated by value below:
 *   page        #0e0e10      surface     #161619      surface-hover  #1d1d21
 *   border      #2c2c32      border-hi   #3e3e46      focus          #d8d8de
 *   text        #ececf0      muted       #9a9aa2      disabled       #55555c
 *   primary     #e6e6ea  on-primary #0b0b0c
 *
 * Calamares runs as ROOT with the default LIGHT Qt palette, so anything not
 * styled here comes out light-on-white. Several rules below exist only to
 * stop that (tooltips, combo popups, item-view delegates); each says why.
 *
 * url() paths are absolute: QSS resolves relative ones against the working
 * directory, not this file.
 */

/* ----- surfaces & text ---------------------------------------------------- */
#mainApp,
QWidget {
    background-color: #0e0e10;
    color: #ececf0;
    font-size: 10pt;
}
QLabel {
    background: transparent;
    color: #ececf0;
}
QLabel:disabled {
    color: #55555c;
}

/* Tooltips — root's light palette would make them yellow. */
QToolTip {
    background-color: #1d1d21;
    color: #ececf0;
    border: 1px solid #3e3e46;
    border-radius: 6px;
    padding: 5px 9px;
}

/* Context menus (e.g. right-click in the manual partitioning table). */
QMenu {
    background-color: #161619;
    border: 1px solid #2c2c32;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 5px;
}
QMenu::item:selected {
    background-color: #e6e6ea;
    color: #0b0b0c;
}
QMenu::separator {
    height: 1px;
    background: #2c2c32;
    margin: 4px 6px;
}

/* ----- buttons -------------------------------------------------------------
   Every button inside a page is SECONDARY (outlined): the one primary action
   on screen is Next/Install in the navigation bar. The exception is a
   dialog's default button ("Yes, install", "OK"), which is filled. */
QPushButton {
    background-color: #161619;
    color: #ececf0;
    border: 1px solid #2c2c32;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 20px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #1d1d21;
    border-color: #3e3e46;
}
QPushButton:pressed {
    background-color: #26262b;
}
QPushButton:focus {
    border-color: #d8d8de;
}
QPushButton:disabled {
    background-color: transparent;
    color: #55555c;
    border-color: #1f1f23;
}
QPushButton:default,
QDialogButtonBox QPushButton:default {
    background-color: #e6e6ea;
    color: #0b0b0c;
    border: none;
}
QPushButton:default:hover {
    background-color: #f5f5f7;
}
QPushButton:default:pressed {
    background-color: #c9c9cf;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
QToolButton:hover {
    background-color: #1d1d21;
    border-color: #2c2c32;
}

/* ----- text inputs -------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #161619;
    color: #ffffff;
    border: 1px solid #2c2c32;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #e6e6ea;
    selection-color: #0b0b0c;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #3e3e46;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #d8d8de;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #55555c;
    background-color: #111113;
    border-color: #1f1f23;
}
QLineEdit[readOnly="true"] {
    background-color: #111113;
}
/* Password dots: the small centred bullet, not the large disc that sits low. */
QLineEdit {
    lineedit-password-character: 8226;
}
/* The partition page's "Encrypt system" row: Calamares fixes the row's height
   to the passphrase field's height at the moment it is built — before this
   stylesheet applies, i.e. Qt's default 30 px (EncryptWidget.cpp:
   setFixedHeight(...) "Avoid jumping up and down"). With the 7 px padding
   above, the fields want ~36 px, are squeezed into 30, and the dots end up at
   the bottom with their lower half cut off. Keep these two inside 30 px. */
#m_passphraseLineEdit, #m_confirmLineEdit {
    padding: 1px 10px;
}

/* ----- combo boxes ---------------------------------------------------------
   combobox-popup:0 forces the stylable list popup instead of a native one:
   the native popup paints from root's LIGHT palette, which left the options
   on a white background. */
QComboBox {
    combobox-popup: 0;
    padding-right: 30px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url("/usr/share/calamares/branding/maze/chevron-down.svg");
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #161619;
    color: #ececf0;
    border: 1px solid #3e3e46;
    border-radius: 6px;
    selection-background-color: #e6e6ea;
    selection-color: #0b0b0c;
    outline: 0;
    padding: 4px;
}
/* Per-item colours too: the delegate otherwise fills each row from the light
   palette, leaving white behind the options even on a dark view. */
QComboBox QAbstractItemView::item {
    background-color: #161619;
    color: #ececf0;
    padding: 6px 10px;
    min-height: 22px;
    border: none;
    border-radius: 5px;
}
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #e6e6ea;
    color: #0b0b0c;
}

/* ----- check boxes & radio buttons ----------------------------------------- */
QCheckBox, QRadioButton {
    background: transparent;
    color: #ececf0;
    spacing: 10px;
    padding: 3px 0px;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #55555c;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #5a5a63;
    background-color: #161619;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QRadioButton::indicator {
    border-radius: 10px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #9a9aa2;
    background-color: #1d1d21;
}
QCheckBox::indicator:checked {
    background-color: #e6e6ea;
    border-color: #e6e6ea;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
QRadioButton::indicator:checked {
    background-color: #e6e6ea;
    border-color: #e6e6ea;
    image: url("/usr/share/calamares/branding/maze/radio-dot.svg");
}
QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background-color: #f5f5f7;
    border-color: #f5f5f7;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #2c2c32;
    background-color: transparent;
}

/* ----- lists, trees, tables -------------------------------------------------
   Locale/keyboard lists, the manual-partitioning table, the summary. Qt paints
   the item-view check boxes from the VIEW's palette (root's light one), which
   gave invisible ticks — hence the explicit ::indicator rules. */
QListView, QTreeView, QTableView {
    background-color: #111113;
    alternate-background-color: #141416;
    color: #ececf0;
    border: 1px solid #222226;
    border-radius: 8px;
    outline: 0;
    selection-background-color: #26262b;
    selection-color: #ffffff;
}
QListView {
    padding: 4px;
}
QListView::item {
    padding: 7px 10px;
    border-radius: 6px;
    color: #ececf0;
}
QTreeView::item, QTableView::item {
    padding: 5px 6px;
}
QListView::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #18181b;
}
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #e6e6ea;
    color: #0b0b0c;
}
QListView::indicator, QTreeView::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #5a5a63;
    background-color: #161619;
    border-radius: 5px;
}
QListView::indicator:checked, QTreeView::indicator:checked {
    background-color: #e6e6ea;
    border-color: #e6e6ea;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
/* Partly ticked group (the Options page): without this it looks UNticked. */
QListView::indicator:indeterminate, QTreeView::indicator:indeterminate,
QCheckBox::indicator:indeterminate {
    background-color: #9a9aa2;
    border-color: #9a9aa2;
    image: url("/usr/share/calamares/branding/maze/dash.svg");
}
QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: #141416;
    color: #9a9aa2;
    border: none;
    border-bottom: 1px solid #2c2c32;
    padding: 6px 8px;
    font-weight: 600;
}
QTableCornerButton::section {
    background-color: #141416;
    border: none;
}

/* Welcome page — the failed-requirement rows. Calamares' ResultDelegate tints
   each row from the Qt palette (amber for warnings, red for hard failures),
   and with root's light palette those come out PALE, so the row text must be
   DARK to be readable. QSS cannot change the tint; it can set the text. This
   list only ever shows failed requirements, so the rule is scoped to it. */
ResultsListWidget QListView {
    color: #1a1a1a;
    background-color: transparent;
    border: none;
}

/* ----- group boxes, frames, splitters --------------------------------------- */
QGroupBox {
    border: 1px solid #222226;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9a9aa2;
    font-weight: 600;
}
QSplitter::handle {
    background-color: #1d1d21;
}

/* ----- scroll bars -------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #2c2c32;
    border-radius: 3px;
    min-height: 32px;
    min-width: 32px;
}
QScrollBar::handle:hover {
    background-color: #45454d;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ----- progress (the install page) ----------------------------------------- */
QProgressBar {
    background-color: #1a1a1d;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #e6e6ea;
    border-radius: 5px;
}
/* The installation progress bar shows its percentage ("%p%", set by Calamares)
   — without a number a long, quiet step (building the boot images, the system
   update) looks frozen. The number sits to the RIGHT of the bar, in the bar's
   right margin, so it reads the same at 5 % and at 95 % (drawn on the bar it
   vanished, white on the white fill). */
QProgressBar#exec-progress {
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
    margin-right: 64px;
    text-align: right;
    color: #f2f2f4;
    font-weight: 700;
}
QProgressBar#exec-progress::chunk {
    border-radius: 6px;
}

/* ----- dialogs ------------------------------------------------------------ */
QDialog, QMessageBox {
    background-color: #121214;
}
QMessageBox QLabel {
    color: #ececf0;
}
