/* Maze Linux — Calamares stylesheet: dark-grey surface, off-white buttons. */

#mainApp,
QWidget {
    background-color: #0e0e0e;
    color: #f2f2f2;
}

/* Tooltips — Calamares runs as root with the light palette (yellow background).
   Force dark-grey so they match the OLED theme. */
QToolTip {
    background-color: #1c1c1c;
    color: #eaeaea;
    border: 1px solid rgba(255,255,255,0.14);
    padding: 4px 8px;
}

/* Sidebar (step list) — a touch darker than the main surface for separation. */
#sidebarApp {
    background-color: #070707;
    border-right: 1px solid rgba(255,255,255,0.08);
}
#sidebarMenuApp {
    background-color: #070707;
    border: none;
}
/* Kill the thin separator line Calamares draws between the sidebar logo and the
   step list — match it to the sidebar background so it becomes invisible. */
#sidebarApp QFrame {
    border: none;
    color: #070707;
}
QWidget#sidebarApp QLabel {
    color: #a8a8a8;
}

/* Headings / text */
QLabel[text] {
    color: #f2f2f2;
}

/* Buttons — soft OFF-WHITE (dirty white), not pure white, with dark text. */
QPushButton {
    background-color: #e6e6e6;
    color: #1a1a1a;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: #d4d4d4;
}
QPushButton:pressed {
    background-color: #c8c8c8;
}
QPushButton:disabled {
    background-color: rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.38);
}

/* Inputs — frosted-glass on the dark-grey surface. */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: rgba(255,255,255,0.06);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #e6e6e6;
    selection-color: #1a1a1a;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #e6e6e6;
}

/* Force the item-view popup instead of a native one, so the QSS below is
   ALWAYS honoured. Calamares runs as root with the default (light) Qt palette,
   so a native combo popup paints its frame/items from that light palette and
   the options end up on a white background. combobox-popup:0 makes Qt use the
   stylable list popup. */
QComboBox {
    combobox-popup: 0;
}

/* Drop-down POPUP list (e.g. the swap / filesystem choice). Without this the
   items render on a white background (root's light palette) and are unreadable;
   give the popup a dark surface AND set explicit per-item colours (the delegate
   otherwise fills each item from the light palette, leaving white-behind-the-
   options even when the view background is dark). */
QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    color: #f2f2f2;
    border: 1px solid rgba(255,255,255,0.16);
    selection-background-color: #e6e6e6;
    selection-color: #1a1a1a;
    outline: 0;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    background-color: #1a1a1a;
    color: #f2f2f2;
    padding: 6px 10px;
    min-height: 20px;
    border: none;
}
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #e6e6e6;
    color: #1a1a1a;
}

/* Welcome page — system-requirements WARNINGS at the very start of the install.
   Calamares' ResultDelegate paints each failed-requirement row with a colour it
   derives from the *Qt palette* window colour: amber (H=60) for soft warnings,
   red (H=0) for hard failures. Calamares runs as root with the default LIGHT
   palette, so those tints come out pale (pale-yellow / pale-red), while the row
   text is drawn in QPalette::Text — which our global input rule had set to
   white, giving unreadable white-on-pale-yellow. QSS can't change the delegate's
   palette-derived background, but it CAN set the Text role: scope DARK text to
   just this list (it only ever lists FAILED requirements) so the warnings are
   legible. Other item views (partition tree, combo popups) keep light-on-dark.
   The class selector 'ResultsListWidget' is Calamares' welcome-checker widget. */
ResultsListWidget QListView {
    color: #1a1a1a;
    background-color: transparent;
    border: none;
}

/* ===== PACKAGE-CHOOSER LIST VIEW ============================================
   The packagechooser module renders items in a QListView with per-row
   checkboxes (Qt::CheckStateRole) drawn by the delegate — NOT real QCheckBox
   widgets.  Indicator styling is repeated for both QCheckBox::indicator (in case
   any page does use real widgets) and QListView::indicator (for the delegate
   checkboxes). */

/* Checkboxes — widget form (may not apply to packagechooser, kept as fallback). */
QCheckBox {
    color: #eaeaea;
    spacing: 10px;
    font-size: 10pt;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255,255,255,0.50);
    background-color: rgba(255,255,255,0.10);
    border-radius: 4px;
}
QCheckBox::indicator:hover {
    border-color: rgba(255,255,255,0.75);
    background-color: rgba(255,255,255,0.16);
}
QCheckBox::indicator:checked {
    background-color: #e6e6e6;
    border-color: #e6e6e6;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
QCheckBox::indicator:checked:hover {
    background-color: #f0f0f0;
    border-color: #f0f0f0;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
QCheckBox::indicator:disabled {
    border-color: rgba(255,255,255,0.15);
    background-color: transparent;
}

/* Item-view indicator — the checkboxes painted by QStyledItemDelegate inside
   the QListView.  Qt uses the *view's* palette for these, which on root's light
   palette yields invisible dark-on-dark ticks.  Fill the checked box with
   off-white so the SVG (dark stroke) or native tick is clearly visible. */
QListView {
    background-color: transparent;
    border: none;
    padding: 6px 0px;
    outline: 0;
    selection-background-color: rgba(255,255,255,0.08);
    selection-color: #eaeaea;
}
QListView::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255,255,255,0.50);
    background-color: rgba(255,255,255,0.10);
    border-radius: 4px;
}
QListView::indicator:hover {
    border-color: rgba(255,255,255,0.75);
    background-color: rgba(255,255,255,0.16);
}
QListView::indicator:checked {
    background-color: #e6e6e6;
    border-color: #e6e6e6;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
QListView::indicator:checked:hover {
    background-color: #f0f0f0;
    border-color: #f0f0f0;
    image: url("/usr/share/calamares/branding/maze/checkmark.svg");
}
QListView::item {
    padding: 12px 6px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    min-height: 44px;
    color: #eaeaea;
}
QListView::item:hover {
    background-color: rgba(255,255,255,0.04);
}
QListView::item:selected {
    color: #ffffff;
    background-color: rgba(255,255,255,0.06);
}
QListView QLabel {
    color: #888899;
    font-size: 9pt;
    padding-left: 2px;
}

/* Radio buttons — kept for any non-packagechooser page that may use them. */
QRadioButton {
    color: #eaeaea;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255,255,255,0.50);
    background-color: rgba(255,255,255,0.10);
    border-radius: 10px;
}
QRadioButton::indicator:hover {
    border-color: rgba(255,255,255,0.75);
    background-color: rgba(255,255,255,0.16);
}
QRadioButton::indicator:checked {
    background-color: #e6e6e6;
    border-color: #e6e6e6;
}
QRadioButton::indicator:checked:hover {
    background-color: #f0f0f0;
    border-color: #f0f0f0;
}
QRadioButton::indicator:disabled {
    border-color: rgba(255,255,255,0.15);
    background-color: transparent;
}

/* Progress bar */
QProgressBar {
    background-color: rgba(255,255,255,0.08);
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
}
QProgressBar::chunk {
    background-color: #e6e6e6;
    border-radius: 6px;
}
